// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===========================
// UTILISATEURS (Authentification)
// ===========================
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  login     String?  @unique @db.VarChar(50) // Identifiant de connexion unique
  password  String   @db.VarChar(255)
  role      Role     @default(ASSISTANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  professeur    Professeur?
  assistant     Assistant?
  notifications Notification[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN_INFORMATIQUE
  ADMIN_ELECTRONIQUE
  PROFESSEUR
  ASSISTANT
}

enum Specialty {
  INFORMATIQUE
  ELECTRONIQUE
}

// ===========================
// PROFESSEURS / RESPONSABLE PÉDAGOGIQUE
// ===========================
model Professeur {
  id          Int        @id @default(autoincrement())
  userId      Int        @unique
  nom         String     @db.VarChar(100)
  prenom      String     @db.VarChar(100)
  telephone   String?    @db.VarChar(20)
  departement String?    @db.VarChar(100)
  specialite  Specialty? @default(INFORMATIQUE)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seances Seance[]

  @@map("professeurs")
}

// ===========================
// ASSISTANTS
// ===========================
model Assistant {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  nom            String    @db.VarChar(100)
  prenom         String    @db.VarChar(100)
  deuxiemePrenom String?   @db.VarChar(100) // Deuxième prénom pour le login
  telephone      String?   @db.VarChar(20)
  formation      String?   @db.VarChar(150)
  niveau         String?   @db.VarChar(20) // M1, M2, L3, etc.
  inscription    DateTime? @db.Date
  statut         Statut    @default(ACTIF)
  note           String?   @db.Text
  heuresMax      Int       @default(120)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties    AssistantSpecialty[]
  matieres       AssistantMatiere[]
  disponibilites Disponibilite[]
  affectations   Affectation[]
  candidature    Candidature?

  @@map("assistants")
}

model AssistantSpecialty {
  assistantId Int
  specialty   Specialty

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@id([assistantId, specialty])
  @@map("assistant_specialties")
}

enum Statut {
  ACTIF
  INACTIF
  CONGE
}

// ===========================
// CANDIDATURES ASSISTANTS
// ===========================
model Candidature {
  id             Int                    @id @default(autoincrement())
  nom            String                 @db.VarChar(100)
  prenom         String                 @db.VarChar(100)
  deuxiemePrenom String?                @db.VarChar(100) // Deuxième prénom pour le login
  email          String                 @db.VarChar(255)
  telephone      String?                @db.VarChar(20)
  formation      String                 @db.VarChar(150)
  niveau         String                 @db.VarChar(20)
  disponibilites String?                @db.Text
  motivation     String?                @db.Text // Lettre de motivation
  cvUrl          String?                @db.VarChar(512) // Chemin du CV uploadé
  statut         StatutCandidature      @default(EN_ATTENTE)
  commentaire    String?                @db.Text
  motifRefus     String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  assistantId Int?                   @unique
  assistant   Assistant?             @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  specialties CandidatureSpecialty[]

  @@map("candidatures")
}

model CandidatureSpecialty {
  candidatureId Int
  specialty     Specialty

  candidature Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@id([candidatureId, specialty])
  @@map("candidature_specialties")
}

enum StatutCandidature {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

// ===========================
// MATIÈRES
// ===========================
model Matiere {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(20) // ex: ALGO, BDD, POO
  nom         String    @db.VarChar(150)
  description String?   @db.Text
  couleur     String?   @db.VarChar(10) // ex: #4361ee
  specialite  Specialty @default(INFORMATIQUE)

  assistants AssistantMatiere[]
  seances    Seance[]

  @@map("matieres")
}

// Table de jointure Assistants <-> Matières
model AssistantMatiere {
  assistantId Int
  matiereId   Int

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  matiere   Matiere   @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@id([assistantId, matiereId])
  @@map("assistant_matieres")
}

// ===========================
// SÉANCES (de TP/TD)
// ===========================
model Seance {
  id                     Int          @id @default(autoincrement())
  matiereId              Int
  professeurId           Int
  groupe                 String       @db.VarChar(50) // ex: Groupe A2
  date                   DateTime     @db.Date
  heureDebut             String       @db.VarChar(5) // ex: 08:00
  heureFin               String       @db.VarChar(5) // ex: 10:00
  salle                  String?      @db.VarChar(50)
  type                   TypeSeance   @default(TP)
  niveau                 String?      @db.VarChar(50) // ex: Niveau L2
  statut                 StatutSeance @default(PLANIFIEE)
  nombreAssistantsRequis Int          @default(1)
  specialite             Specialty    @default(INFORMATIQUE)

  matiere      Matiere                 @relation(fields: [matiereId], references: [id])
  professeur   Professeur              @relation(fields: [professeurId], references: [id])
  affectations Affectation[]
  historique   HistoriqueReservation[]

  @@map("seances")
}

enum TypeSeance {
  TP
  TD
}

enum StatutSeance {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

// ===========================
// DISPONIBILITÉS
// ===========================
model Disponibilite {
  id            Int     @id @default(autoincrement())
  assistantId   Int
  jourSemaine   Int // 0 = Dimanche, 1 = Lundi ... 6 = Samedi
  heureDebut    String  @db.VarChar(5) // ex: 08:00
  heureFin      String  @db.VarChar(5) // ex: 12:00
  estDisponible Boolean @default(true)

  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@map("disponibilites")
}

// ===========================
// AFFECTATIONS
// ===========================
model Affectation {
  id                     Int               @id @default(autoincrement())
  seanceId               Int
  assistantId            Int
  statut                 StatutAffectation @default(EN_ATTENTE)
  heuresCount            Float             @default(2.0) // Durée de la séance en heures
  commentaire            String?           @db.Text
  statutHeures           StatutHeures      @default(EN_ATTENTE)
  commentaireHeures      String?           @db.Text
  dateValidationHeures   DateTime?
  statutPresence         StatutPresence    @default(PRESENCE_A_VALIDER)
  dateValidationPresence DateTime?
  valideParProfesseurId  Int?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  seance    Seance    @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  assistant Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@unique([seanceId, assistantId])
  @@map("affectations")
}

enum StatutAffectation {
  EN_ATTENTE
  VALIDEE
  REFUSEE
  ANNULEE
}

enum StatutHeures {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

enum StatutPresence {
  PRESENCE_A_VALIDER
  PRESENT
  ABSENT
}

// ===========================
// HISTORIQUE DE RÉSERVATION
// ===========================
model HistoriqueReservation {
  id            Int      @id @default(autoincrement())
  seanceId      Int
  assistantId   Int
  affectationId Int?
  action        String   @db.VarChar(50) // RESERVATION, ANNULATION, VALIDATION, REFUS, LIBERATION_ADMIN
  dateAction    DateTime @default(now())
  ancienStatut  String?  @db.VarChar(50)
  nouveauStatut String?  @db.VarChar(50)
  effectuePar   String?  @db.VarChar(100)
  commentaire   String?  @db.Text

  seance Seance @relation(fields: [seanceId], references: [id], onDelete: Cascade)

  @@map("historique_reservations")
}

// ===========================
// HISTORIQUE PÉDAGOGIQUE GENERAL
// ===========================
model HistoriquePeda {
  id          Int      @id @default(autoincrement())
  utilisateur String   @db.VarChar(150)
  action      String   @db.VarChar(100)
  objet       String   @db.VarChar(150)
  details     String?  @db.Text
  date        DateTime @default(now())

  @@map("historique_pedagogique")
}

// ===========================
// NOTIFICATIONS
// ===========================
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(50)
  titre     String   @db.VarChar(150)
  message   String   @db.Text
  lien      String?  @db.VarChar(255)
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lu])
  @@map("notifications")
}

// ===========================
// CONFIGURATION DU SYSTÈME
// ===========================
model SystemConfig {
  id                      Int     @id @default(1)
  blocageCreneauEnAttente Boolean @default(false)

  @@map("system_config")
}

// ===========================
// IMPORT EXCEL (BRUT)
// ===========================
model PlanningImport {
  id          Int      @id @default(autoincrement())
  filename    String   @db.VarChar(255)
  importDate  DateTime @default(now())
  importedBy  String?  @db.VarChar(100) // userId/nom
  status      String   @default("EN_ATTENTE") // EN_ATTENTE, DOC_ANALYSE, DONNEES_IMPORTEES, TERMINE, ERREUR
  totalSheets Int      @default(0)
  totalRows   Int      @default(0)
  totalCells  Int      @default(0)
  createdAt   DateTime @default(now())

  columns PlanningImportColumn[]
  rawData PlanningRawData[]

  @@map("planning_imports")
}

model PlanningImportColumn {
  id          Int    @id @default(autoincrement())
  importId    Int
  sheetName   String @db.VarChar(255)
  columnName  String @db.VarChar(255)
  columnIndex Int

  import PlanningImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, sheetName])
  @@map("planning_import_columns")
}

model PlanningRawData {
  id        Int      @id @default(autoincrement())
  importId  Int
  sheetName String   @db.VarChar(255)
  rowNumber Int
  dataJson  Json
  createdAt DateTime @default(now())

  import PlanningImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  // Utile pour retrouver facilement les lignes d'une feuille d'un import
  @@index([importId, sheetName])
  @@map("planning_raw_data")
}
